# Local development example values only.
POSTGRES_DB=enma
POSTGRES_USER=enma
POSTGRES_PASSWORD=enma_local_password
POSTGRES_PORT=5432

# Database roles (D33), local example values only. POSTGRES_USER stays the
# container's bootstrap superuser; scripts/setup-local.ps1 creates these roles
# with deploy/postgres/enma-roles.sql, applies the migrations as the migrator
# and points the API at the application role. Names match
# ^[a-z_][a-z0-9_]{0,62}$; passwords are URL-safe, at least 16 characters, and
# all three PostgreSQL passwords differ.
POSTGRES_MIGRATOR_USER=enma_migrator
POSTGRES_MIGRATOR_PASSWORD=enma_migrator_local_password
POSTGRES_APP_USER=enma_app
POSTGRES_APP_PASSWORD=enma_app_local_password

# Local MinIO development only.
# Root credentials are used only by the one-shot bootstrap container.
MINIO_ROOT_USER=enma-minio-root
MINIO_ROOT_PASSWORD=enma_minio_root_local_password_2026

# Restricted application identity for the private Documents bucket.
MINIO_APP_ACCESS_KEY=enma-documents-app
MINIO_APP_SECRET_KEY=enma_documents_local_secret_2026

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
