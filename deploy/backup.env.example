# ENMA off-site backup configuration template (D29). Install it on the host as
# /etc/enma/backup.env (owner root, chmod 600) and replace every <placeholder>.
# Never commit real values.

# age public key (recipient) only. The private key is generated and kept
# offline, outside the host, and is supplied only at restore time.
ENMA_BACKUP_AGE_RECIPIENT=<age1-public-key>

# S3-compatible destination in Brazil, with a provider/account different from
# the host. The bucket's lifecycle rule enforces the 7-day retention.
ENMA_BACKUP_S3_ENDPOINT=<https://s3-endpoint>
ENMA_BACKUP_S3_BUCKET=<backup-bucket>
# Optional key prefix, empty or ending with "/".
ENMA_BACKUP_S3_PREFIX=enma/

# Write-only credential: PutObject on the bucket, no read, list or delete.
ENMA_BACKUP_S3_ACCESS_KEY=<write-only-access-key>
ENMA_BACKUP_S3_SECRET_KEY=<write-only-secret-key>

# External heartbeat monitor: one URL pinged after a successful upload, one
# pinged on any failure (optional, but recommended).
ENMA_BACKUP_HEARTBEAT_SUCCESS_URL=<https://heartbeat-success-url>
ENMA_BACKUP_HEARTBEAT_FAILURE_URL=<https://heartbeat-failure-url>

# Optional working directory for the temporary, mode-700 staging area
# (default /var/tmp); needs room for one full backup.
# ENMA_BACKUP_WORK_DIR=/var/tmp
