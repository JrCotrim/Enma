# ENMA Production configuration template. Install it on the host outside the
# repository checkout as /etc/enma/production.env, owned by root with mode 600
# (scripts/production/*.sh refuse anything else), and replace every
# <placeholder>. Never commit real values. Generate secrets URL-safe, e.g.
# `openssl rand -hex 32`. Never add "Include Error Detail" to any setting.

# Image tag built for this release and its commit. deploy.sh <tag> requires
# ENMA_IMAGE_TAG to equal <tag>; rollback = previous tag.
ENMA_IMAGE_TAG=<release-tag>
ENMA_REVISION=<git-commit-sha>

# Public hostname served by Caddy (no scheme, no port) and the ACME account.
ENMA_PUBLIC_HOST=<public-hostname>
ENMA_ACME_EMAIL=<operations-mailbox>

# Optional: private edge network; the API trusts forwarded headers only from
# ENMA_EDGE_PROXY_IP, which must lie inside ENMA_EDGE_SUBNET and outside
# ENMA_EDGE_DYNAMIC_RANGE (the addresses Docker hands to other containers).
# ENMA_EDGE_SUBNET=10.247.31.0/28
# ENMA_EDGE_DYNAMIC_RANGE=10.247.31.8/29
# ENMA_EDGE_PROXY_IP=10.247.31.2

# PostgreSQL (internal network only), three identities (D33). The bootstrap
# superuser creates the database and stays inside the postgres service for the
# scripts (roles and grants over the local socket, backups); the migrator owns
# the schema and applies migrations; the API connects as the application role
# (DML only). Role names match ^[a-z_][a-z0-9_]{0,62}$ (not pg_*); the three
# names and the three passwords must all differ; the migrator and application
# passwords are URL-safe with at least 16 characters.
ENMA_POSTGRES_DB=<database-name>
ENMA_POSTGRES_USER=<bootstrap-superuser>
ENMA_POSTGRES_PASSWORD=<bootstrap-superuser-password>
ENMA_POSTGRES_MIGRATOR_USER=<migrator-role>
ENMA_POSTGRES_MIGRATOR_PASSWORD=<migrator-password>
ENMA_POSTGRES_APP_USER=<application-role>
ENMA_POSTGRES_APP_PASSWORD=<application-password>

# MinIO: root identity is used only by the one-shot bootstrap and by the
# restore script (URL-safe values required); the API uses the restricted
# application identity; backup.sh mirrors the documents with the read-only
# backup identity (D36: list the bucket and read its objects, URL-safe values
# required). The three access keys and the three secrets must all differ.
ENMA_MINIO_ROOT_USER=<minio-root-user>
ENMA_MINIO_ROOT_PASSWORD=<minio-root-password>
ENMA_MINIO_APP_ACCESS_KEY=<minio-app-access-key>
ENMA_MINIO_APP_SECRET_KEY=<minio-app-secret-key>
ENMA_MINIO_BACKUP_ACCESS_KEY=<minio-backup-access-key>
ENMA_MINIO_BACKUP_SECRET_KEY=<minio-backup-secret-key>

# SMTP provider (D28): Amazon SES sa-east-1, email-smtp.sa-east-1.amazonaws.com,
# port 587, StartTls, with SES SMTP credentials (not AWS access keys).
ENMA_SMTP_HOST=<smtp-host>
ENMA_SMTP_PORT=<smtp-port>
ENMA_SMTP_SECURITY=<StartTls-or-SslOnConnect>
ENMA_SMTP_USERNAME=<smtp-username>
ENMA_SMTP_PASSWORD=<smtp-password>
ENMA_SMTP_SENDER_NAME=<sender-display-name>
ENMA_SMTP_SENDER_ADDRESS=<sender-mailbox>

# Google sign-in (optional). With true, register exactly
# https://<public-hostname>/signin-google as the redirect URI.
ENMA_GOOGLE_ENABLED=false
ENMA_GOOGLE_CLIENT_ID=
ENMA_GOOGLE_CLIENT_SECRET=
