{
  "AllowedHosts": "localhost;127.0.0.1",
  "Authentication": {
    "Google": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EmailVerification": {
    "DevelopmentDelivery": {
      "SenderName": "ENMA Pilot"
    }
  },
  "DocumentStorage": {
    "BucketName": "enma-pilot-documents",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "RequireTls": false
  }
}
